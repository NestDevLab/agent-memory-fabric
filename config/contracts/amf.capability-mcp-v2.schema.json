{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory-fabric.local/contracts/amf.capability-mcp-v2.schema.json",
  "title": "Capability MCP v2 conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "advertisedTools", "authorizationMatrix", "rankingPolicy", "scenarios"],
  "properties": {
    "schema": { "const": "amf.capability-mcp-conformance/v2" },
    "advertisedTools": { "$ref": "#/$defs/tools" },
    "authorizationMatrix": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/authRule" } },
    "rankingPolicy": { "$ref": "#/$defs/rankingPolicy" },
    "scenarios": { "type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "tools": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["search", "read", "propose", "proposal_status", "status"] } },
    "tool": { "enum": ["search", "read", "propose", "proposal_status", "status"] },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "scopeType": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "scopeId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "scopeRef": { "type": "object", "additionalProperties": false, "required": ["tenantId", "type", "scopeId"], "properties": { "tenantId": { "$ref": "#/$defs/tenantId" }, "type": { "$ref": "#/$defs/scopeType" }, "scopeId": { "$ref": "#/$defs/scopeId" } } },
    "scopeRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/scopeRef" } },
    "purpose": { "enum": ["memory_recall", "conversation_recall", "context_recall", "memory_curation"] },
    "recallPurpose": { "enum": ["memory_recall", "conversation_recall", "context_recall"] },
    "resourceId": { "type": "string", "pattern": "^rid_[A-Za-z0-9_-]{8,128}$" },
    "cursor": { "type": ["string", "null"], "pattern": "^cur_[A-Za-z0-9_-]{16,256}$" },
    "kinds": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["canonical_memory", "document", "conversation", "resource"] } },
    "searchArguments": { "type": "object", "additionalProperties": false, "required": ["query", "scopes", "purpose"], "properties": { "query": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" }, "kinds": { "$ref": "#/$defs/kinds" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "$ref": "#/$defs/purpose" }, "delivery": { "enum": ["results", "notice"] }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 }, "cursor": { "$ref": "#/$defs/cursor" } }, "allOf": [{ "if": { "properties": { "delivery": { "const": "notice" } }, "required": ["delivery"] }, "then": { "properties": { "purpose": { "const": "context_recall" } }, "not": { "anyOf": [{ "required": ["cursor"] }, { "required": ["limit"] }] } } }] },
    "readArguments": { "type": "object", "additionalProperties": false, "required": ["id", "scopes", "purpose"], "properties": { "id": { "$ref": "#/$defs/resourceId" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "$ref": "#/$defs/purpose" } } },
    "proposeArguments": { "type": "object", "additionalProperties": false, "required": ["scope", "claim", "purpose", "idempotencyKey"], "properties": { "scope": { "$ref": "#/$defs/scopeRef" }, "claim": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" }, "purpose": { "const": "memory_curation" }, "idempotencyKey": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,128}$" } } },
    "proposalStatusArguments": { "type": "object", "additionalProperties": false, "required": ["id", "scopes", "purpose"], "properties": { "id": { "$ref": "#/$defs/resourceId" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "const": "memory_curation" } } },
    "statusArguments": { "type": "object", "additionalProperties": false, "maxProperties": 0, "properties": {} },
    "searchRequest": { "type": "object", "additionalProperties": false, "required": ["name", "arguments"], "properties": { "name": { "const": "search" }, "arguments": { "$ref": "#/$defs/searchArguments" } } },
    "readRequest": { "type": "object", "additionalProperties": false, "required": ["name", "arguments"], "properties": { "name": { "const": "read" }, "arguments": { "$ref": "#/$defs/readArguments" } } },
    "proposeRequest": { "type": "object", "additionalProperties": false, "required": ["name", "arguments"], "properties": { "name": { "const": "propose" }, "arguments": { "$ref": "#/$defs/proposeArguments" } } },
    "proposalStatusRequest": { "type": "object", "additionalProperties": false, "required": ["name", "arguments"], "properties": { "name": { "const": "proposal_status" }, "arguments": { "$ref": "#/$defs/proposalStatusArguments" } } },
    "statusRequest": { "type": "object", "additionalProperties": false, "required": ["name", "arguments"], "properties": { "name": { "const": "status" }, "arguments": { "$ref": "#/$defs/statusArguments" } } },
    "request": { "oneOf": [{ "$ref": "#/$defs/searchRequest" }, { "$ref": "#/$defs/readRequest" }, { "$ref": "#/$defs/proposeRequest" }, { "$ref": "#/$defs/proposalStatusRequest" }, { "$ref": "#/$defs/statusRequest" }] },
    "ranking": { "type": "object", "additionalProperties": false, "required": ["position", "reasons"], "properties": { "position": { "type": "integer", "minimum": 1, "maximum": 10000 }, "reasons": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["exact_anchor", "authority", "freshness", "hybrid_similarity", "recency"] } } } },
    "resource": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "admission", "ranking", "contradiction"], "properties": { "id": { "$ref": "#/$defs/resourceId" }, "kind": { "enum": ["canonical_memory", "document", "conversation", "resource"] }, "text": { "type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S" }, "admission": { "const": "authorized" }, "ranking": { "$ref": "#/$defs/ranking" }, "contradiction": { "enum": ["none", "present", "unknown"] } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["state", "requestedKinds", "coveredKinds", "uncoveredKinds", "reasons"], "properties": { "state": { "enum": ["complete", "partial"] }, "requestedKinds": { "$ref": "#/$defs/kinds" }, "coveredKinds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["canonical_memory", "document", "conversation", "resource"] } }, "uncoveredKinds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["canonical_memory", "document", "conversation", "resource"] } }, "reasons": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["unavailable", "budget_exhausted", "source_inaccessible", "unknown"] } } } },
    "proposal": { "type": "object", "additionalProperties": false, "required": ["id", "state"], "properties": { "id": { "$ref": "#/$defs/resourceId" }, "state": { "enum": ["queued", "pending", "review_required", "approved", "rejected", "applied", "failed"] } } },
    "readiness": { "type": "object", "additionalProperties": false, "required": ["name", "state"], "properties": { "name": { "$ref": "#/$defs/tool" }, "state": { "enum": ["ready", "unavailable"] } } },
    "notice": { "type": "object", "additionalProperties": false, "required": ["mode", "state", "candidateCount", "expansionRequired"], "properties": { "mode": { "const": "notice_only" }, "state": { "enum": ["available", "none"] }, "candidateCount": { "type": "integer", "minimum": 0, "maximum": 50 }, "expansionRequired": { "const": true } } },
    "publicResult": { "type": "object", "additionalProperties": false, "required": ["ok", "outcome"], "properties": { "ok": { "type": "boolean" }, "outcome": { "enum": ["found", "not_found", "notice", "queued", "pending", "ready", "unavailable", "forbidden", "invalid_request"] }, "id": { "$ref": "#/$defs/resourceId" }, "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/resource" } }, "resource": { "$ref": "#/$defs/resource" }, "notice": { "$ref": "#/$defs/notice" }, "proposal": { "$ref": "#/$defs/proposal" }, "nextCursor": { "$ref": "#/$defs/cursor" }, "coverage": { "$ref": "#/$defs/coverage" }, "capabilities": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/readiness" } } }, "allOf": [
      { "if": { "properties": { "outcome": { "const": "found" } }, "required": ["outcome"] }, "then": { "oneOf": [{ "required": ["items", "nextCursor", "coverage"] }, { "required": ["resource"] }] } },
      { "if": { "properties": { "outcome": { "const": "notice" } }, "required": ["outcome"] }, "then": { "required": ["notice"], "not": { "anyOf": [{ "required": ["id"] }, { "required": ["items"] }, { "required": ["resource"] }, { "required": ["proposal"] }, { "required": ["nextCursor"] }, { "required": ["coverage"] }, { "required": ["capabilities"] }] } } },
      { "if": { "properties": { "outcome": { "const": "queued" } }, "required": ["outcome"] }, "then": { "required": ["id"] } },
      { "if": { "properties": { "outcome": { "const": "pending" } }, "required": ["outcome"] }, "then": { "required": ["proposal"] } },
      { "if": { "properties": { "outcome": { "enum": ["ready", "unavailable"] } }, "required": ["outcome"] }, "then": { "required": ["capabilities"] } },
      { "if": { "properties": { "outcome": { "enum": ["not_found", "forbidden", "invalid_request"] } }, "required": ["outcome"] }, "then": { "not": { "anyOf": [{ "required": ["id"] }, { "required": ["items"] }, { "required": ["resource"] }, { "required": ["proposal"] }, { "required": ["nextCursor"] }, { "required": ["coverage"] }, { "required": ["capabilities"] }] } } },
      { "if": { "properties": { "outcome": { "enum": ["found", "notice", "queued", "pending", "ready"] } }, "required": ["outcome"] }, "then": { "properties": { "ok": { "const": true } } } },
      { "if": { "properties": { "outcome": { "enum": ["not_found", "unavailable", "forbidden", "invalid_request"] } }, "required": ["outcome"] }, "then": { "properties": { "ok": { "const": false } } } }
    ] },
    "authRule": { "type": "object", "additionalProperties": false, "required": ["tool", "capability", "permission", "purpose", "scopeBinding", "failure"], "properties": { "tool": { "$ref": "#/$defs/tool" }, "capability": { "$ref": "#/$defs/tool" }, "permission": { "enum": ["fabric:search", "fabric:read", "fabric:propose", "fabric:proposal_status", "fabric:status"] }, "purpose": { "type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/purpose" } }, "scopeBinding": { "enum": ["required_scope_ref", "none"] }, "failure": { "enum": ["not_found", "forbidden", "invalid_request"] } } },
    "rankClass": { "type": "object", "additionalProperties": false, "required": ["name", "ordinal"], "properties": { "name": { "enum": ["unknown", "derived_projection", "attributed_observation", "reviewed_canonical", "source_authority"] }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 4 } } },
    "freshnessBucket": { "type": "object", "additionalProperties": false, "required": ["name", "ordinal", "minAgeSeconds", "maxAgeSeconds"], "properties": { "name": { "enum": ["unknown", "old", "aged", "recent", "current"] }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 4 }, "minAgeSeconds": { "type": ["integer", "null"], "minimum": 0 }, "maxAgeSeconds": { "type": ["integer", "null"], "minimum": 0 } } },
    "rankingPolicy": { "type": "object", "additionalProperties": false, "required": ["revision", "tenantMode", "scopeSetSemantics", "identityDedup", "admissionOrder", "candidateLanes", "rankingOrder", "fusion", "rrfK", "authorityDirection", "authorityDomain", "freshnessDirection", "freshnessReference", "freshnessTimestampOrder", "futureTimestampHandling", "expiredCandidateHandling", "freshnessDomain", "snapshotBinding"], "properties": { "revision": { "const": "capability-mcp-v2-rank/v2" }, "tenantMode": { "const": "single_tenant_reject_mixed" }, "scopeSetSemantics": { "const": "authorized_union" }, "identityDedup": { "const": "tenant_id_plus_scope_id" }, "admissionOrder": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["current_authorization", "scope_membership", "purpose_kind"] } }, "candidateLanes": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["exact", "lexical", "fuzzy", "vector"] } }, "rankingOrder": { "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["exact_anchor", "authority", "freshness", "reciprocal_rank_fusion", "recency", "opaque_resource_id"] } }, "fusion": { "const": "reciprocal_rank_fusion" }, "rrfK": { "const": 60 }, "authorityDirection": { "const": "higher_ordinal_first" }, "authorityDomain": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/rankClass" } }, "freshnessDirection": { "const": "higher_ordinal_first" }, "freshnessReference": { "const": "snapshot_ranked_at_utc" }, "freshnessTimestampOrder": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["effective_at", "observed_at", "source_modified_at", "ingested_at"] } }, "futureTimestampHandling": { "const": "reject_candidate" }, "expiredCandidateHandling": { "const": "exclude_before_ranking" }, "freshnessDomain": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/freshnessBucket" } }, "snapshotBinding": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["authorization_revision", "coverage_revision", "lane_positions", "ranking_policy_revision", "ranked_at_utc"] } } } },
    "operatorRegistry": { "type": "object", "additionalProperties": false, "required": ["enabledCapabilities", "providerAssignments"], "properties": { "enabledCapabilities": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "$ref": "#/$defs/tool" } }, "providerAssignments": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["capability", "providerId"], "properties": { "capability": { "$ref": "#/$defs/tool" }, "providerId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" } } } }, "compositeSearch": { "type": "object", "additionalProperties": false, "required": ["capability", "candidateKinds"], "properties": { "capability": { "const": "search" }, "candidateKinds": { "$ref": "#/$defs/kinds" } } } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "request", "expected"], "properties": { "id": { "enum": ["v1_defaults_scope_ref", "explicit_conversation", "explicit_resource_context", "notice_only_delivery", "denied_conversation_purpose", "denied_resource_scope", "read_found_reauthorized", "read_no_existence_oracle", "read_revoked_reauthorization", "partial_coverage", "contradiction_visible", "stable_opaque_paging", "proposal_queued", "proposal_lifecycle", "status_redaction", "missing_composite_startup", "ambiguous_provider_startup", "alias_non_advertisement"] }, "request": { "$ref": "#/$defs/request" }, "expected": { "$ref": "#/$defs/publicResult" }, "registry": { "$ref": "#/$defs/operatorRegistry" }, "alias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" } } }
  }
}
