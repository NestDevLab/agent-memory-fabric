{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory-fabric.local/contracts/amf.scope-migration-plan-v1.schema.json",
  "title": "AMF scope migration v1 dry-run conformance manifest",
  "description": "A bounded no-write inventory and reviewed disposition plan for legacy scope values; digest canonicalization uses the bounded RFC 8785 JCS domain defined in docs/scope-migration-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "authorityEvidence", "knownTenants", "canonicalScopes", "legacyValues", "plan", "writeOperations"],
  "properties": {
    "schema": { "const": "amf.scope-migration-plan-conformance/v1" },
    "mode": { "const": "dry-run" },
    "authorityEvidence": { "$ref": "#/$defs/mappingEvidence" },
    "knownTenants": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/tenantId" } },
    "canonicalScopes": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/scopeRef" } },
    "legacyValues": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/legacyValue" } },
    "plan": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/planRow" } },
    "writeOperations": { "type": "array", "maxItems": 0, "items": false }
  },
  "$defs": {
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "scopeType": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "scopeId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "legacyId": { "type": "string", "pattern": "^legacy-[a-z0-9-]{3,79}$" },
    "sourceRef": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "evidenceId": { "type": "string", "pattern": "^evidence-[a-z0-9-]{3,79}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reissueRequestId": { "type": "string", "pattern": "^reissue-[a-z0-9-]{3,79}$" },
    "scopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "type", "scopeId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/tenantId" },
        "type": { "$ref": "#/$defs/scopeType" },
        "scopeId": { "$ref": "#/$defs/scopeId" }
      }
    },
    "mappingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/evidenceId" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "legacyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value", "sourceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/legacyId" },
        "kind": { "enum": ["scope", "grant", "bundle", "record", "route", "cursor"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "observedCandidates": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/scopeRef" } }
      }
    },
    "classification": { "enum": ["naked", "two-segment", "owner-first", "type-first", "prefix", "wildcard", "duplicate", "unknown-tenant", "collision", "stale-opaque-reference"] },
    "planRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacyId", "classification", "disposition"],
      "properties": {
        "legacyId": { "$ref": "#/$defs/legacyId" },
        "classification": { "$ref": "#/$defs/classification" },
        "disposition": { "enum": ["map", "block", "expire-and-reissue"] },
        "target": { "$ref": "#/$defs/scopeRef" },
        "mappingEvidence": { "$ref": "#/$defs/mappingEvidence" },
        "reissueRequestId": { "$ref": "#/$defs/reissueRequestId" }
      },
      "oneOf": [
        {
          "properties": { "disposition": { "const": "map" } },
          "required": ["disposition", "target", "mappingEvidence"],
          "not": { "anyOf": [{ "required": ["reissueRequestId"] }] }
        },
        {
          "properties": { "disposition": { "const": "block" } },
          "required": ["disposition"],
          "not": { "anyOf": [{ "required": ["target"] }, { "required": ["mappingEvidence"] }, { "required": ["reissueRequestId"] }] }
        },
        {
          "properties": { "disposition": { "const": "expire-and-reissue" } },
          "required": ["disposition", "reissueRequestId"],
          "not": { "anyOf": [{ "required": ["target"] }, { "required": ["mappingEvidence"] }] }
        }
      ]
    }
  }
}
