{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory-fabric.local/contracts/amf.session-context-capsule-v1.schema.json",
  "title": "AMF SessionContextCapsule v1 conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capabilityBinding", "scenarios"],
  "properties": { "schema": { "const": "amf.session-context-capsule-conformance/v1" }, "capabilityBinding": { "$ref": "#/$defs/capabilityBinding" }, "scenarios": { "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/scenario" } } },
  "$defs": {
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" }, "scopeType": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" }, "scopeId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "scopeRef": { "type": "object", "additionalProperties": false, "required": ["tenantId", "type", "scopeId"], "properties": { "tenantId": { "$ref": "#/$defs/tenantId" }, "type": { "$ref": "#/$defs/scopeType" }, "scopeId": { "$ref": "#/$defs/scopeId" } } }, "scopeRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/scopeRef" } },
    "capsuleId": { "type": "string", "pattern": "^csc_[A-Za-z0-9_-]{8,128}$" }, "snippetRef": { "type": "string", "pattern": "^snp_[A-Za-z0-9_-]{8,128}$" }, "expansionRef": { "$ref": "#/$defs/resourceId" }, "resourceId": { "type": "string", "pattern": "^rid_[A-Za-z0-9_-]{8,128}$" }, "cursor": { "type": ["string", "null"], "pattern": "^cur_[A-Za-z0-9_-]{16,256}$" }, "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "recallRequest": { "type": "object", "additionalProperties": false, "required": ["mode", "query", "scopes", "purpose"], "properties": { "mode": { "const": "manual_recall" }, "query": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "const": "context_recall" }, "limit": { "type": "integer", "minimum": 1, "maximum": 10 }, "cursor": { "$ref": "#/$defs/cursor" } } },
    "noticeRequest": { "type": "object", "additionalProperties": false, "required": ["mode", "scopes", "purpose"], "properties": { "mode": { "const": "automatic_notice" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "const": "context_recall" } } },
    "expandRequest": { "type": "object", "additionalProperties": false, "required": ["mode", "expansionRef", "scopes", "purpose"], "properties": { "mode": { "const": "explicit_expand" }, "expansionRef": { "$ref": "#/$defs/expansionRef" }, "scopes": { "$ref": "#/$defs/scopeRefs" }, "purpose": { "const": "context_recall" } } },
    "request": { "oneOf": [{ "$ref": "#/$defs/recallRequest" }, { "$ref": "#/$defs/noticeRequest" }, { "$ref": "#/$defs/expandRequest" }] },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceRef", "observedAt", "authority"], "properties": { "sourceKind": { "const": "conversation" }, "sourceRef": { "$ref": "#/$defs/resourceId" }, "observedAt": { "$ref": "#/$defs/timestamp" }, "authority": { "enum": ["source_asserted", "derived"] } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["observedAt", "expiresAt", "state"], "properties": { "observedAt": { "$ref": "#/$defs/timestamp" }, "expiresAt": { "$ref": "#/$defs/timestamp" }, "state": { "enum": ["fresh", "stale", "expired", "unknown"] } } },
    "relevance": { "type": "object", "additionalProperties": false, "required": ["state", "overlap", "reasons"], "properties": { "state": { "enum": ["relevant", "irrelevant", "unknown"] }, "overlap": { "type": "integer", "minimum": 0, "maximum": 100 }, "reasons": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["exact_anchor", "authority", "freshness", "hybrid_similarity", "recency"] } } } },
    "snippet": { "type": "object", "additionalProperties": false, "required": ["ref", "text", "redacted"], "properties": { "ref": { "$ref": "#/$defs/snippetRef" }, "text": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" }, "redacted": { "const": true } } },
    "capsule": { "type": "object", "additionalProperties": false, "required": ["id", "provenance", "freshness", "relevance", "contradiction", "supersession", "snippets", "expansionRef"], "properties": { "id": { "$ref": "#/$defs/capsuleId" }, "provenance": { "$ref": "#/$defs/provenance" }, "freshness": { "$ref": "#/$defs/freshness" }, "relevance": { "$ref": "#/$defs/relevance" }, "contradiction": { "enum": ["none", "present", "unknown"] }, "supersession": { "enum": ["current", "superseded", "unknown"] }, "snippets": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/snippet" } }, "expansionRef": { "$ref": "#/$defs/expansionRef" } } },
    "excerpt": { "type": "object", "additionalProperties": false, "required": ["id", "text", "redacted"], "properties": { "id": { "type": "string", "pattern": "^exc_[A-Za-z0-9_-]{8,128}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" }, "redacted": { "const": true } } },
    "notice": { "type": "object", "additionalProperties": false, "required": ["mode", "state", "candidateCount", "expansionRequired"], "properties": { "mode": { "const": "notice_only" }, "state": { "enum": ["available", "none"] }, "candidateCount": { "type": "integer", "minimum": 0, "maximum": 50 }, "expansionRequired": { "const": true } } },
    "response": { "type": "object", "additionalProperties": false, "required": ["ok", "outcome"], "properties": { "ok": { "type": "boolean" }, "outcome": { "enum": ["found", "not_found", "notice"] }, "capsules": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/capsule" } }, "nextCursor": { "$ref": "#/$defs/cursor" }, "items": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/excerpt" } }, "notice": { "$ref": "#/$defs/notice" } }, "allOf": [
      { "if": { "properties": { "outcome": { "const": "found" } }, "required": ["outcome"] }, "then": { "oneOf": [{ "required": ["capsules", "nextCursor"] }, { "required": ["items"] }] } },
      { "if": { "properties": { "outcome": { "const": "notice" } }, "required": ["outcome"] }, "then": { "required": ["notice"], "not": { "anyOf": [{ "required": ["capsules"] }, { "required": ["items"] }, { "required": ["nextCursor"] }] } } },
      { "if": { "properties": { "outcome": { "const": "not_found" } }, "required": ["outcome"] }, "then": { "not": { "anyOf": [{ "required": ["capsules"] }, { "required": ["items"] }, { "required": ["nextCursor"] }, { "required": ["notice"] }] } } },
      { "if": { "properties": { "outcome": { "enum": ["found", "notice"] } }, "required": ["outcome"] }, "then": { "properties": { "ok": { "const": true } } } }, { "if": { "properties": { "outcome": { "const": "not_found" } }, "required": ["outcome"] }, "then": { "properties": { "ok": { "const": false } } } }
    ] },
    "capabilityBinding": { "type": "object", "additionalProperties": false, "required": ["capabilityMcp", "purpose", "adapterVisibility", "manualRecallMapping", "noticeMapping", "expansionMapping", "publicReferenceScheme", "noticeAuthorization", "expansionAuthorization"], "properties": { "capabilityMcp": { "const": "capability-mcp/v2" }, "purpose": { "const": "context_recall" }, "adapterVisibility": { "const": "private_internal_only" }, "manualRecallMapping": { "const": "search_delivery_results" }, "noticeMapping": { "const": "search_delivery_notice" }, "expansionMapping": { "const": "read_resource_id" }, "publicReferenceScheme": { "const": "rid" }, "noticeAuthorization": { "const": "current_grant_before_count" }, "expansionAuthorization": { "const": "separate_current_grant" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "request", "expected"], "properties": { "id": { "enum": ["relevant", "irrelevant", "stale", "expired", "contradictory", "superseded", "notice_only", "denied_notice", "revoked_notice", "bounded_expansion", "denied_expansion", "scope_mismatch_expansion"] }, "request": { "$ref": "#/$defs/request" }, "expected": { "$ref": "#/$defs/response" } } }
  }
}
